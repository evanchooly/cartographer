<idea-plugin>
    <id>com.antwerkz.cartographer</id>
    <name>Cartographer</name>
    <vendor email="jlee@antwerkz.com" url="https://github.com/evanchooly/cartographer">antwerkz</vendor>
    <description><![CDATA[
        Cartographer visualizes OpenTelemetry trace output captured by the Cartographer Maven plugin
        during test runs, rendering it as a waterfall directly inside the IDE. It also
        provides an action to insert a Cartographer Maven profile into a pom.xml, and lets you jump
        from a span in the waterfall to the source location that produced it.
    ]]></description>
    <change-notes><![CDATA[
        Initial release.
    ]]></change-notes>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow
            id="Cartographer"
            anchor="bottom"
            factoryClass="com.antwerkz.cartographer.intellij.CartographerToolWindowFactory"
        />
        <notificationGroup id="Cartographer" displayType="BALLOON" isLogByDefault="true"/>
    </extensions>

    <actions>
        <action id="com.antwerkz.cartographer.SetupCartographerAction"
                class="com.antwerkz.cartographer.intellij.SetupCartographerAction"
                text="Add Cartographer Profile"
                description="Insert a Cartographer Maven profile into this pom.xml">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
